# GitHub Actions publishes this image on every push to the release branch.
PIXSTORE_IMAGE=ghcr.io/fathah/pixstore:latest

# Server port. Use BIND_ADDRESS=127.0.0.1 when running behind a local reverse proxy.
BIND_ADDRESS=0.0.0.0
PORT=8081

# Replace each value with a different secret (openssl rand -hex 32).
# Use a hex password here because Compose inserts it into a PostgreSQL URL.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
ADMIN_SECRET=replace-with-a-random-admin-secret
API_KEY=replace-with-a-random-search-api-key
